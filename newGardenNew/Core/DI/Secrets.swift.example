import Foundation

// Copia este archivo como `Secrets.swift` en esta misma carpeta y pon tus llaves.
// `Secrets.swift` está en .gitignore: las llaves nunca van al repositorio.
//
// - plantNetAPIKey: llave de https://my.plantnet.org (plan gratuito sin fines de lucro).
//   Sin llave, la identificación por foto queda desactivada y se agrega la planta a mano.
// - weatherAPIComKeyTemporary: llave de https://www.weatherapi.com, solo mientras WeatherKit
//   no esté habilitado en el App ID. Sin llave, el motor de riego usa Open-Meteo.
enum Secrets {
    static let plantNetAPIKey = ""
    static let weatherAPIComKeyTemporary = ""
}
