  <diagram name="Navegacion" id="nav">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Arquitectura de información, antes y después" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="900" height="34" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Qué pestañas existen, qué hay dentro de cada una, y por dónde entra el usuario" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1000" height="22" as="geometry"/></mxCell>

        <mxCell id="hdrA" value="ANTES, 3 pestañas organizadas por tipo de dato" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=none;fontColor=#ffffff;fontSize=14;fontStyle=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="620" height="40" as="geometry"/></mxCell>
        <mxCell id="hdrB" value="DESPUÉS, 4 pestañas organizadas por intención del usuario" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2d7a2d;strokeColor=none;fontColor=#ffffff;fontSize=14;fontStyle=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="800" y="100" width="620" height="40" as="geometry"/></mxCell>

        <mxCell id="aentry" value="Onboarding (Sign in with Apple / omitir) → Tutorial de 6 tarjetas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="158" width="620" height="36" as="geometry"/></mxCell>

        <mxCell id="at1" value="&lt;b&gt;🌱 Plantas&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Lista alfabética&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="216" width="196" height="56" as="geometry"/></mxCell>
        <mxCell id="at2" value="&lt;b&gt;📊 Análisis&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;6 tarjetas apiladas&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="272" y="216" width="196" height="56" as="geometry"/></mxCell>
        <mxCell id="at3" value="&lt;b&gt;⚙️ Ajustes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;10 secciones&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="484" y="216" width="196" height="56" as="geometry"/></mxCell>

        <mxCell id="at1a" value="Detalle de planta&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;3 sub-pestañas con solo iconos:&lt;br&gt;Cuidado / Especie / Fotos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="292" width="196" height="54" as="geometry"/></mxCell>
        <mxCell id="at1b" value="Añadir planta&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;5 pasos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="196" height="44" as="geometry"/></mxCell>
        <mxCell id="at1c" value="Ajuste masivo por clima&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#b85450&quot;&gt;icono sin etiqueta, arriba a la izquierda&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;arcSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="60" y="418" width="196" height="48" as="geometry"/></mxCell>

        <mxCell id="at2a" value="Estado · Clima · Necesitan agua&lt;br&gt;Racha · Centro de Salud · Historial&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#b85450&quot;&gt;todas con el mismo peso visual&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="272" y="292" width="196" height="60" as="geometry"/></mxCell>
        <mxCell id="at2b" value="Chequeo de salud&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#b85450&quot;&gt;3 niveles de profundidad&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="272" y="366" width="196" height="48" as="geometry"/></mxCell>

        <mxCell id="at3a" value="&lt;font color=&quot;#b85450&quot;&gt;&lt;b&gt;4 claves de API&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Idioma · Cuenta · Ubicación · IA&lt;br&gt;Clima · PlantNet · Trefle · Mascotas&lt;br&gt;Info · Zona de peligro&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2f2;strokeColor=#b85450;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="484" y="292" width="196" height="74" as="geometry"/></mxCell>

        <mxCell id="agarden" value="🍃 Jardín&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size:10px&quot;&gt;desactivada, código comentado&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=11;arcSize=10;dashed=1;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="484" y="380" width="196" height="34" as="geometry"/></mxCell>

        <mxCell id="aprob" value="&lt;b&gt;El problema de esta estructura&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&quot;Análisis&quot; no es una intención del usuario, es una categoría técnica. Nadie abre la app pensando &quot;voy a analizar&quot;. Piensa &quot;¿tengo que regar algo?&quot;.&lt;br&gt;&lt;br&gt;La pregunta que trae al usuario a la app no tiene pantalla propia: hay que entrar en Plantas y escanear una lista alfabética descifrando puntos de color.&lt;br&gt;&lt;br&gt;El Centro de Salud, que es de las funciones más valiosas, está a tres toques de profundidad dentro de una pestaña que no lo anuncia.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2f2;strokeColor=#b85450;fontSize=13;verticalAlign=top;spacingTop=8;spacingLeft=10;align=left;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="620" height="180" as="geometry"/></mxCell>

        <mxCell id="bentry" value="Onboarding corto → &lt;b&gt;directo a la cámara&lt;/b&gt; · Tutorial accesible pero no obligatorio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef7ee;strokeColor=#2d7a2d;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="800" y="158" width="620" height="36" as="geometry"/></mxCell>

        <mxCell id="bt1" value="&lt;b&gt;☀️ Hoy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Qué hacer ahora&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d7a2d;strokeWidth=3;fontSize=13;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="800" y="216" width="146" height="56" as="geometry"/></mxCell>
        <mxCell id="bt2" value="&lt;b&gt;🌱 Plantas&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Mi colección&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="958" y="216" width="146" height="56" as="geometry"/></mxCell>
        <mxCell id="bt3" value="&lt;b&gt;🩺 Salud&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;¿Está enferma?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d7a2d;strokeWidth=2;fontSize=13;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1116" y="216" width="146" height="56" as="geometry"/></mxCell>
        <mxCell id="bt4" value="&lt;b&gt;⚙️ Ajustes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;4 secciones&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1274" y="216" width="146" height="56" as="geometry"/></mxCell>

        <mxCell id="bt1a" value="&lt;b&gt;Hoy&lt;/b&gt; · vence hoy o con retraso&lt;br&gt;&lt;b&gt;Esta semana&lt;/b&gt; · lo que viene&lt;br&gt;&lt;b&gt;Todo en orden&lt;/b&gt; · plegado&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#2d7a2d&quot;&gt;Regar en un toque, con deshacer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d7a2d;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="800" y="292" width="146" height="76" as="geometry"/></mxCell>
        <mxCell id="bt1b" value="Clima de hoy en contexto&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&quot;32° y sin lluvia: 3 plantas&lt;br&gt;necesitan agua antes&quot;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d7a2d;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="800" y="382" width="146" height="64" as="geometry"/></mxCell>

        <mxCell id="bt2a" value="Cuadrícula con fotos grandes&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;filtros: estado, ubicación, especie&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="958" y="292" width="146" height="58" as="geometry"/></mxCell>
        <mxCell id="bt2b" value="Ficha de planta&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;foto a ancho completo,&lt;br&gt;scroll único sin sub-pestañas&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="958" y="364" width="146" height="64" as="geometry"/></mxCell>
        <mxCell id="bt2c" value="Añadir&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#2d7a2d&quot;&gt;2 pasos desde la cámara&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d7a2d;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="958" y="442" width="146" height="50" as="geometry"/></mxCell>

        <mxCell id="bt3a" value="Diagnóstico con la cámara&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PlantNet enfermedades + IA&lt;br&gt;Ahora es una pestaña,&lt;br&gt;no un botón enterrado&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d7a2d;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1116" y="292" width="146" height="76" as="geometry"/></mxCell>
        <mxCell id="bt3b" value="Historial de salud&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;evolución por planta&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1116" y="382" width="146" height="50" as="geometry"/></mxCell>

        <mxCell id="bt4a" value="Mascotas&lt;br&gt;Notificaciones&lt;br&gt;Ubicación&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;IA avanzada (opcional,&lt;br&gt;plegado por defecto)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1274" y="292" width="146" height="84" as="geometry"/></mxCell>

        <mxCell id="bext" value="&lt;b&gt;Entradas sin abrir la app&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#2d7a2d&quot; style=&quot;font-size:10px&quot;&gt;NUEVO&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Widget de inicio · Widget de pantalla de bloqueo · &quot;Oye Siri, riega la Monstera&quot; · Atajos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d7a2d;strokeWidth=2;fontSize=13;verticalAlign=top;spacingTop=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="800" y="516" width="620" height="58" as="geometry"/></mxCell>

        <mxCell id="bwin" value="&lt;b&gt;Por qué esta estructura funciona mejor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Cada pestaña responde a una pregunta que el usuario ya se hace:&lt;br&gt;&lt;b&gt;Hoy&lt;/b&gt; → ¿tengo que hacer algo? &amp;nbsp;·&amp;nbsp; &lt;b&gt;Plantas&lt;/b&gt; → ¿qué tengo? &amp;nbsp;·&amp;nbsp; &lt;b&gt;Salud&lt;/b&gt; → esto se ve mal, ¿qué le pasa?&lt;br&gt;&lt;br&gt;La acción principal (regar) pasa de 3 toques a 1, y además sale de la app hacia el widget y Siri.&lt;br&gt;Ajustes baja de 10 secciones a 4 porque las claves de API dejan de ser obligatorias.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef7ee;strokeColor=#2d7a2d;fontSize=13;verticalAlign=top;spacingTop=8;spacingLeft=10;align=left;arcSize=8;" vertex="1" parent="1"><mxGeometry x="800" y="594" width="620" height="146" as="geometry"/></mxCell>

