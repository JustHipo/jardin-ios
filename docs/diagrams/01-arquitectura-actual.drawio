        <mxCell id="prob1" value="&lt;b&gt;C1: Clave de API en el código fuente&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;GroqService.swift:12 lleva la clave de Groq escrita. Está en el binario y en el historial de git. Cuando se agote esa cuota, todos los usuarios pierden la IA a la vez.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2f2;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="700" width="360" height="100" as="geometry"/></mxCell>
        <mxCell id="prob2" value="&lt;b&gt;C2: La tarea de fondo usa otra base de datos&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;BackgroundAnalysisScheduler crea su propio ModelContainer sin las configuraciones CloudKit/Local. Escribe en un almacén distinto del que lee la interfaz.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2f2;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="440" y="700" width="360" height="100" as="geometry"/></mxCell>
        <mxCell id="prob3" value="&lt;b&gt;A1: Doble fuente de verdad&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;UserSettings declara hasPets, petType y aiProvider, pero el código que los lee usa UserDefaults con claves de texto. Un error de tipeo desactiva los avisos de toxicidad en silencio.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2f2;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="820" y="700" width="370" height="100" as="geometry"/></mxCell>

        <mxCell id="keyblock" value="&lt;b&gt;El usuario debe conseguir estas 4 claves&lt;br&gt;antes de que la app sirva para algo&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;PlantNet · OpenAI o Anthropic · WeatherAPI · Trefle&lt;br&gt;&lt;br&gt;Severidad 4 de 4 en la escala de Nielsen:&lt;br&gt;impide completar la tarea principal.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=none;fontColor=#ffffff;fontSize=13;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1010" y="480" width="180" height="176" as="geometry"/></mxCell>

        <mxCell id="legend" value="&lt;b&gt;Leyenda&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6c8ebf&quot;&gt;■&lt;/font&gt; Presentación&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#82b366&quot;&gt;■&lt;/font&gt; Datos&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#9673a6&quot;&gt;■&lt;/font&gt; IA&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#d79b00&quot;&gt;■&lt;/font&gt; Servicios externos&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#b85450&quot;&gt;■&lt;/font&gt; Problema detectado" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="60" y="820" width="1000" height="24" as="geometry"/></mxCell>

