<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram name="Pipeline de IA" id="pipeline">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Pipeline de IA, antes y después" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="900" height="34" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Alta de una planta, desde que el usuario decide añadirla hasta que queda guardada" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1000" height="22" as="geometry"/></mxCell>

        <mxCell id="hdrA" value="ANTES, 5 pasos, 3 claves de API, 20 a 40 segundos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=none;fontColor=#ffffff;fontSize=14;fontStyle=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="620" height="40" as="geometry"/></mxCell>
        <mxCell id="hdrB" value="DESPUÉS, 2 pasos, 0 claves obligatorias, 3 a 8 segundos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2d7a2d;strokeColor=none;fontColor=#ffffff;fontSize=14;fontStyle=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="800" y="100" width="620" height="40" as="geometry"/></mxCell>

        <mxCell id="a0" value="&lt;b&gt;Requisito previo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Ir a Ajustes, registrarse en 4 webs, copiar y pegar 4 claves de API&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=13;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="620" height="56" as="geometry"/></mxCell>

        <mxCell id="a1" value="&lt;b&gt;Paso 1&lt;/b&gt;&amp;nbsp;&amp;nbsp;Escribir contexto libre&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Luz, maceta, tierra, ubicación · 12 chips de sugerencia · apodo opcional&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="236" width="620" height="54" as="geometry"/></mxCell>
        <mxCell id="a2" value="&lt;b&gt;Paso 2&lt;/b&gt;&amp;nbsp;&amp;nbsp;Seleccionar hasta 5 fotos de la fototeca&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Elegir cuál es la principal&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="310" width="620" height="54" as="geometry"/></mxCell>
        <mxCell id="a3" value="&lt;b&gt;Paso 3&lt;/b&gt;&amp;nbsp;&amp;nbsp;Pulsar &quot;Analizar&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="384" width="620" height="38" as="geometry"/></mxCell>

        <mxCell id="a4" value="PlantNet &lt;font style=&quot;font-size:11px&quot;&gt;/v2/identify/all&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;top 5 con score&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;verticalAlign=middle;arcSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="442" width="196" height="56" as="geometry"/></mxCell>
        <mxCell id="a5" value="LLM confirma y enriquece&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#b85450&quot;&gt;Groq: ignora las fotos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;verticalAlign=middle;arcSize=10;" vertex="1" parent="1"><mxGeometry x="272" y="442" width="196" height="56" as="geometry"/></mxCell>
        <mxCell id="a6" value="Trefle busca imagen&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;una llamada por sugerencia&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;verticalAlign=middle;arcSize=10;" vertex="1" parent="1"><mxGeometry x="484" y="442" width="196" height="56" as="geometry"/></mxCell>

        <mxCell id="a7" value="&lt;b&gt;Paso 4&lt;/b&gt;&amp;nbsp;&amp;nbsp;Elegir entre 3 sugerencias&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Tarjetas con nombre, confianza como texto en inglés, riego, sol, toxicidad&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="518" width="620" height="54" as="geometry"/></mxCell>
        <mxCell id="a8" value="&lt;b&gt;Paso 5&lt;/b&gt;&amp;nbsp;&amp;nbsp;Formulario final&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Nombre (obligatorio) · días de riego · especie · sol · notas&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="592" width="620" height="54" as="geometry"/></mxCell>
        <mxCell id="a9" value="&lt;b&gt;Guardar&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="666" width="620" height="38" as="geometry"/></mxCell>

        <mxCell id="apain" value="&lt;b&gt;Dónde se pierde al usuario&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;• En Ajustes, antes de empezar: 4 registros en webs distintas&lt;br&gt;• En el paso 1: se le pide escribir antes de haber visto nada&lt;br&gt;• En el paso 3: 20 a 40 s de espera con un indicador circular sin progreso&lt;br&gt;• Si falla PlantNet, el error dice &quot;PlantNet returned error 429&quot;&lt;br&gt;• La app dice que analiza las fotos pero en modo gratuito las descarta&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2f2;strokeColor=#b85450;fontSize=13;verticalAlign=top;spacingTop=8;spacingLeft=10;align=left;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="724" width="620" height="134" as="geometry"/></mxCell>

        <mxCell id="b0" value="&lt;b&gt;Requisito previo&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#2d7a2d&quot;&gt;ninguno&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;La app funciona completa desde el primer segundo tras instalarla&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d7a2d;strokeWidth=2;fontSize=13;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="800" y="160" width="620" height="56" as="geometry"/></mxCell>

        <mxCell id="b1" value="&lt;b&gt;Paso 1&lt;/b&gt;&amp;nbsp;&amp;nbsp;Apuntar con la cámara&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;La identificación arranca sola mientras el usuario encuadra. Sin formulario previo.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="800" y="236" width="620" height="54" as="geometry"/></mxCell>

        <mxCell id="b2" value="PlantNet&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;clave incluida en la app&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;verticalAlign=middle;arcSize=10;" vertex="1" parent="1"><mxGeometry x="800" y="310" width="300" height="54" as="geometry"/></mxCell>
        <mxCell id="b3" value="Foundation Models&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;on-device · @Generable&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d7a2d;strokeWidth=2;fontSize=12;verticalAlign=middle;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1120" y="310" width="300" height="54" as="geometry"/></mxCell>

        <mxCell id="b4" value="&lt;b&gt;Paso 2&lt;/b&gt;&amp;nbsp;&amp;nbsp;Confirmar especie y dónde vive&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&quot;¿Es esta? Monstera deliciosa, 94% de confianza según PlantNet&quot;&lt;br&gt;Ubicación con 4 opciones grandes: interior luminoso / interior sombrío / exterior sol / exterior sombra&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="800" y="384" width="620" height="70" as="geometry"/></mxCell>

        <mxCell id="b5" value="&lt;b&gt;Guardada&lt;/b&gt;&amp;nbsp;&amp;nbsp;con nombre, especie, ciclo de riego y toxicidad ya rellenos&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Todo editable después. Nada obligatorio salvo la foto.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2d7a2d;strokeColor=none;fontColor=#ffffff;fontSize=13;verticalAlign=top;spacingTop=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="800" y="474" width="620" height="54" as="geometry"/></mxCell>

        <mxCell id="b6" value="&lt;b&gt;Después, opcional:&lt;/b&gt; tarjeta &quot;mejora la precisión&quot;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Tamaño de maceta, tipo de tierra, contexto libre. Aparece en la ficha de la planta,&lt;br&gt;no bloquea nada, y muestra cuánto mejora la predicción al rellenarla.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=13;verticalAlign=top;spacingTop=6;arcSize=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="800" y="548" width="620" height="66" as="geometry"/></mxCell>

        <mxCell id="bwin" value="&lt;b&gt;Qué cambia de fondo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;• El primer resultado llega en 3 s en vez de 40 s&lt;br&gt;• El contexto libre no desaparece: se mueve a después de guardar, donde es una mejora y no un peaje&lt;br&gt;• @Generable devuelve tipos de Swift, no texto que hay que decodificar: se acaban los fallos silenciosos de parseo&lt;br&gt;• Sin conexión, el análisis de riego sigue funcionando (solo se pierde la identificación visual)&lt;br&gt;• Las fotos nunca salen del dispositivo salvo para PlantNet, y eso se le dice al usuario&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef7ee;strokeColor=#2d7a2d;fontSize=13;verticalAlign=top;spacingTop=8;spacingLeft=10;align=left;arcSize=8;" vertex="1" parent="1"><mxGeometry x="800" y="634" width="620" height="140" as="geometry"/></mxCell>

        <mxCell id="ea1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;endArrow=block;endFill=1;" edge="1" parent="1" source="a0" target="a1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;endArrow=block;endFill=1;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;endArrow=block;endFill=1;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;endArrow=block;endFill=1;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#999999;endArrow=block;endFill=1;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#999999;endArrow=block;endFill=1;" edge="1" parent="1" source="a5" target="a6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;endArrow=block;endFill=1;" edge="1" parent="1" source="a6" target="a7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;endArrow=block;endFill=1;" edge="1" parent="1" source="a7" target="a8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;endArrow=block;endFill=1;" edge="1" parent="1" source="a8" target="a9"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="eb1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2d7a2d;endArrow=block;endFill=1;" edge="1" parent="1" source="b0" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;endArrow=block;endFill=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;endArrow=block;endFill=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="b1" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2d7a2d;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#999999;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="note" value="&lt;b&gt;El análisis de riego diario sigue el mismo camino:&lt;/b&gt; el ContextBuilder actual (clima + Trefle + historial + fotos + contexto del usuario) se conserva íntegro. Lo único que cambia es quién lo consume: Foundation Models en lugar de una API de pago, y con salida tipada en lugar de JSON en texto." style="text;html=1;fontSize=13;align=left;verticalAlign=top;fontColor=#444444;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="890" width="1360" height="50" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
