        <mxCell id="ds" value="&lt;b&gt;DesignSystem&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#2d7a2d&quot; style=&quot;font-size:10px&quot;&gt;NUEVO&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Tokens: Spacing (escala de 4) · Radius concéntricos · Typography (5 estilos)&lt;br&gt;Color en catálogo de assets: claro / oscuro / alto contraste&lt;br&gt;Componentes: PlantCard · StatusBadge · ActionButton · AICard · EmptyState&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d7a2d;strokeWidth=2;fontSize=13;verticalAlign=top;spacingTop=8;arcSize=8;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="420" height="94" as="geometry"/></mxCell>

