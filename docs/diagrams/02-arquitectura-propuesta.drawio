        <mxCell id="engine" value="&lt;b&gt;WateringAnalysisEngine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Usa el ModelContainer compartido&lt;br&gt;Lotes con presupuesto de tiempo en segundo plano&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d7a2d;fontSize=13;verticalAlign=top;spacingTop=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="640" y="510" width="300" height="70" as="geometry"/></mxCell>

        <mxCell id="audit" value="&lt;b&gt;AIAuditTrail&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#2d7a2d&quot; style=&quot;font-size:10px&quot;&gt;NUEVO&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Cada ajuste deja rastro visible, con fuente,&lt;br&gt;confianza y opción de deshacer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d7a2d;strokeWidth=2;fontSize=13;verticalAlign=top;spacingTop=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="640" y="606" width="300" height="74" as="geometry"/></mxCell>

        <mxCell id="extpn" value="&lt;b&gt;PlantNet&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;clave incluida en la app&lt;br&gt;(plan sin ánimo de lucro)&lt;br&gt;&lt;br&gt;Sigue siendo el mejor&lt;br&gt;clasificador visual:&lt;br&gt;50.000+ especies&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1010" y="216" width="190" height="128" as="geometry"/></mxCell>
