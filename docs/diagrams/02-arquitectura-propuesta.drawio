        <mxCell id="win" value="&lt;b&gt;Lo que gana el usuario&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;✓&amp;nbsp; La app funciona completa al instalarla, sin configurar nada&lt;br&gt;✓&amp;nbsp; Cero claves obligatorias (antes: 4)&lt;br&gt;✓&amp;nbsp; El análisis de riego funciona sin conexión&lt;br&gt;✓&amp;nbsp; Las fotos nunca salen del teléfono&lt;br&gt;✓&amp;nbsp; Coste operativo cero, sin cuota compartida que se agote&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2d7a2d;strokeColor=none;fontColor=#ffffff;fontSize=14;align=left;verticalAlign=top;spacingLeft=16;spacingTop=12;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1010" y="606" width="420" height="140" as="geometry"/></mxCell>

