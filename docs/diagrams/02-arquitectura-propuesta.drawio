        <mxCell id="settings" value="&lt;b&gt;AppSettings&lt;/b&gt;&amp;nbsp;&lt;font color=&quot;#2d7a2d&quot; style=&quot;font-size:10px&quot;&gt;UNIFICADO&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;una sola fuente de verdad&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d7a2d;strokeWidth=2;fontSize=13;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="280" y="456" width="200" height="50" as="geometry"/></mxCell>

        <mxCell id="swiftdata" value="&lt;b&gt;SwiftData: CloudKit + Local&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;SE CONSERVA&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Mismo esquema, mismos modelos, mismas relaciones&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#999999;fontSize=13;verticalAlign=top;spacingTop=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="534" width="420" height="62" as="geometry"/></mxCell>

        <mxCell id="widgets" value="&lt;b&gt;WidgetKit + App Intents&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#2d7a2d&quot; style=&quot;font-size:10px&quot;&gt;NUEVO&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Widget &quot;3 plantas necesitan agua&quot; con riego directo&lt;br&gt;Intent &quot;Regar [planta]&quot; para Siri y Atajos · widget de pantalla de bloqueo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d7a2d;strokeWidth=2;fontSize=13;verticalAlign=top;spacingTop=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="624" width="420" height="76" as="geometry"/></mxCell>

        <mxCell id="aiproto" value="&lt;b&gt;AIEngine (protocolo)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Respuestas tipadas con @Generable, sin JSONDecoder sobre texto libre&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=13;verticalAlign=top;spacingTop=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="640" y="120" width="300" height="70" as="geometry"/></mxCell>

        <mxCell id="fm" value="&lt;b&gt;FoundationModelsEngine&lt;/b&gt;&amp;nbsp;&lt;font color=&quot;#2d7a2d&quot; style=&quot;font-size:10px&quot;&gt;POR DEFECTO&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;IA on-device de Apple&lt;br&gt;Gratis · sin clave · sin cuenta · funciona sin conexión&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d7a2d;strokeWidth=3;fontSize=13;verticalAlign=top;spacingTop=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="640" y="216" width="300" height="80" as="geometry"/></mxCell>

        <mxCell id="cloud" value="&lt;b&gt;CloudAIEngine&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;OPCIONAL&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Claude / OpenAI con clave propia&lt;br&gt;Solo para quien quiera visión avanzada&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;verticalAlign=top;spacingTop=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="640" y="322" width="300" height="74" as="geometry"/></mxCell>

